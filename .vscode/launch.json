{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "wffrasah",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "cwd": "${workspaceFolder}",
            "toolArgs": [
                "--dart-define-from-file=${workspaceFolder}/.env"
            ]
        },
        {
            "name": "wffrasah (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "program": "lib/main.dart",
            "cwd": "${workspaceFolder}",
            "toolArgs": [
                "--dart-define-from-file=${workspaceFolder}/.env"
            ]
        },
        {
            "name": "wffrasah (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "program": "lib/main.dart",
            "cwd": "${workspaceFolder}",
            "toolArgs": [
                "--dart-define-from-file=${workspaceFolder}/.env"
            ]
        }
    ]
}
